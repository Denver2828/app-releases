{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Denver2828/app-releases/schema/update-manifest-v1.schema.json",
  "title": "You2be update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId", "channel", "packageName", "versionCode", "versionName", "publishedAt", "source", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "enum": ["you2be-music", "you2be-music-tv", "you2be-video-tv"] },
    "channel": { "enum": ["stable", "beta"] },
    "packageName": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.]+$" },
    "versionCode": { "type": "integer", "minimum": 1 },
    "versionName": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "releaseNotes": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "abi", "url", "size", "sha256", "packageName", "versionCode", "certificateSha256"],
      "properties": {
        "type": { "enum": ["apk", "patch"] },
        "abi": { "enum": ["universal", "arm64-v8a", "armeabi-v7a", "x86", "x86_64"] },
        "fromVersionCode": { "type": "integer", "minimum": 1 },
        "patchAlgorithm": { "enum": ["bsdiff"] },
        "url": { "type": "string", "pattern": "^https://" },
        "size": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "packageName": { "type": "string" },
        "versionCode": { "type": "integer", "minimum": 1 },
        "certificateSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
